<?xml version="1.0" encoding="utf-8"?>
<!-- No cleartext in a shipped build, for any host. The mock server exception lives in
     src/debug/res/xml/network_security_config.xml, which overrides this file in debug
     builds only. A release APK therefore cannot be pointed at a plaintext endpoint, even
     by someone who reaches the hidden override field. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
